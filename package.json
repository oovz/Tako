{
  "name": "tako-manga-downloader",
  "version": "2.0.0",
  "description": "Batch-download manga chapters from MangaDex, Pixiv Comic, Shonen Jump+, and more. Queue, retry, and export CBZ/ZIP files from Chrome's Side Panel.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "generate:site-integrations": "node scripts/generate-site-integration-registries.mjs",
    "check:site-integrations": "node scripts/generate-site-integration-registries.mjs --check",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "build": "pnpm generate:site-integrations && wxt build",
    "zip": "pnpm generate:site-integrations && wxt zip",
    "type-check": "pnpm generate:site-integrations && tsc --noEmit",
    "lint": "pnpm check:site-integrations && pnpm check:architecture && eslint . --ext .ts,.tsx --config eslint.config.mjs --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "postinstall": "wxt prepare",
    "vitest": "vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:diag": "cross-env TMD_TEST_E2E_DIAG=true playwright test --config=playwright.config.ts",
    "test:e2e:headed": "playwright test --config=playwright.config.ts --headed",
    "test:e2e:coverage": "cross-env E2E_COVERAGE=true TMD_TEST_E2E_USE_MOCKS=true playwright test --config=playwright.config.ts",
    "test:live": "pnpm test:live:full",
    "test:live:full": "playwright test --config=playwright.live.config.ts",
    "test:live:headed": "playwright test --config=playwright.live.config.ts --headed",
    "test:live:ci": "playwright test --config=playwright.live.ci.config.ts",
    "coverage:merge": "node scripts/merge-coverage.mjs",
    "coverage:report": "nyc report --reporter=text --reporter=lcov --reporter=html --temp-dir=.nyc_output --report-dir=coverage/merged",
    "coverage:all": "pnpm test:coverage && pnpm test:e2e:coverage && pnpm coverage:merge && pnpm coverage:report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/chrome": "^0.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "@wxt-dev/module-react": "^1.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "istanbul-lib-coverage": "3.2.2",
    "nyc": "^18.0.0",
    "prettier": "3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "8.1.2",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "4.1.10",
    "web-ext": "^10.6.0",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-virtual": "^3.14.5",
    "bottleneck": "^2.19.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "keywords": [
    "chrome-extension",
    "manga",
    "downloader"
  ],
  "author": "oovz",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
