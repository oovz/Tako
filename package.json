{
  "name": "tako-manga-downloader",
  "version": "2.1.1",
  "description": "Manga downloads, right in your browser. Queue chapters from Chrome’s side panel and keep browsing while they download.",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "wxt",
    "generate:site-integrations": "node scripts/generate-site-integration-registries.mjs",
    "check:site-integrations": "node scripts/generate-site-integration-registries.mjs --check",
    "new:site-integration": "node scripts/new-site-integration.mjs",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "build": "pnpm generate:site-integrations && wxt build",
    "zip": "pnpm generate:site-integrations && wxt zip",
    "type-check": "pnpm generate:site-integrations && tsc --noEmit",
    "lint": "pnpm check:site-integrations && pnpm check:architecture && eslint . --ext .ts,.tsx --config eslint.config.mjs --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "postinstall": "wxt prepare",
    "vitest": "vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:diag": "cross-env TMD_TEST_E2E_DIAG=true playwright test --config=playwright.config.ts",
    "test:e2e:headed": "playwright test --config=playwright.config.ts --headed",
    "test:live": "pnpm test:live:full",
    "test:live:full": "playwright test --config=playwright.live.config.ts",
    "test:live:headed": "playwright test --config=playwright.live.config.ts --headed",
    "test:live:ci": "playwright test --config=playwright.live.ci.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "@wxt-dev/module-react": "^1.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "web-ext": "^10.8.0",
    "wxt": "0.21.5"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.25",
    "bottleneck": "^2.19.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "image-dimensions": "2.6.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "keywords": [
    "chrome-extension",
    "manga",
    "downloader"
  ],
  "author": "oovz",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
