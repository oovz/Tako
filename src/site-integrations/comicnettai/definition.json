{
  "schemaVersion": 1,
  "id": "comicnettai",
  "name": "Comic Nettai",
  "author": "TMD Team",
  "version": "1.1.0",
  "maturity": "stable",
  "shipped": true,
  "enabledByDefault": true,
  "implementationType": "hybrid",
  "volatility": "high",
  "authentication": "browser-session",
  "regions": ["global"],
  "accountConstraints": ["viewer-session-cookie"],
  "patterns": {
    "domains": ["www.comicnettai.com"],
    "seriesMatches": ["/book/*"],
    "excludeMatches": ["/publus/*"]
  },
  "requiredOrigins": [
    "https://www.comicnettai.com/*",
    "https://cdn.comicnettai.com/*"
  ],
  "optionalOrigins": [],
  "policyDefaults": {
    "image": { "concurrency": 2, "delayMs": 1000 },
    "chapter": { "concurrency": 1, "delayMs": 1000 }
  },
  "retryOwner": "platform",
  "pageProbe": "none",
  "runtimes": {
    "background": true,
    "offscreen": true,
    "dispatchContext": { "mode": "none" }
  },
  "imageTransform": {
    "kind": "integrated-descramble",
    "estimatedCostMs": 3000
  },
  "endpointPolicies": [
    {
      "id": "comicnettai-viewer-page",
      "purpose": "Comic Nettai viewer session",
      "origins": ["https://www.comicnettai.com/*"],
      "originKind": "fixed",
      "credentials": "include",
      "redirect": "error",
      "responseType": "html",
      "maxResponseBytes": 15000000
    },
    {
      "id": "comicnettai-viewer-api",
      "purpose": "Comic Nettai viewer protocol",
      "origins": ["https://www.comicnettai.com/*"],
      "originKind": "fixed",
      "credentials": "include",
      "redirect": "error",
      "responseType": "json",
      "maxResponseBytes": 10000000
    },
    {
      "id": "comicnettai-cdn-config",
      "purpose": "Comic Nettai CDN configuration",
      "origins": ["https://cdn.comicnettai.com/*"],
      "originKind": "provider-issued",
      "credentials": "omit",
      "redirect": "error",
      "responseType": "json",
      "maxResponseBytes": 10000000
    },
    {
      "id": "comicnettai-cdn-image",
      "purpose": "Comic Nettai CDN images",
      "origins": ["https://cdn.comicnettai.com/*"],
      "originKind": "provider-issued",
      "credentials": "omit",
      "redirect": "error",
      "responseType": "bytes",
      "maxResponseBytes": 50000000
    }
  ],
  "dynamicOrigins": [],
  "sessionRefererRules": [],
  "customSettings": [],
  "fixtures": {
    "paths": ["src/site-integrations/comicnettai/fixtures/contract.json"],
    "liveFreshnessDays": 30
  }
}
